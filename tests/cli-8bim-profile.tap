#  See the License for the specific language governing permissions and
#  limitations under the License.
#
#  Regression test for Sync8BimProfile(): 8BIM resources whose Pascal name
#  has an odd length carry no pad byte before the size field.
#
. ./common.shi
. ${srcdir}/tests/common.shi
echo "1..8"

TMPDIR_8BIM="cli-8bim_out.d"
rm -rf "${TMPDIR_8BIM}"
mkdir "${TMPDIR_8BIM}" || exit 1

# Emit one 8BIM resource: id 0x0406, a Pascal name of $1 'a' characters,
# a pad byte when the name length is even, then a 2-byte zero payload.
# Octal escapes are used because POSIX printf does not support \x.
resource_with_name() {
  n=$1
  printf '8BIM\004\006'
  printf "\\$(printf '%03o' $n)"
  i=0
  while [ $i -lt $n ]; do printf 'a'; i=`expr $i + 1`; done
  [ `expr $n % 2` -eq 0 ] && printf '\000'
  printf '\000\000\000\002\000\000'
}

# Test 1: writing an image whose 8BIM profile holds a resource with a
# name of length 0 to 5 must succeed.
for n in 0 1 2 3 4 5; do
  resource_with_name $n > "${TMPDIR_8BIM}/name$n.8bim"
  ${CONVERT} -size 16x16 xc:white -profile "8BIM:${TMPDIR_8BIM}/name$n.8bim" \
    "miff:${TMPDIR_8BIM}/name$n.miff" && echo "ok" || echo "not ok"
done

# Test 2: a ResolutionInfo (0x03ED) at 72 dpi that follows a resource with
# an odd-length name must be updated to the image density (300 dpi).
{
  resource_with_name 1
  printf '8BIM\003\355\000\000\000\000\000\020'
  printf '\000\110\000\000\000\001\000\001\000\110\000\000\000\001\000\001'
} > "${TMPDIR_8BIM}/res.8bim"
${CONVERT} -size 16x16 xc:white -profile "8BIM:${TMPDIR_8BIM}/res.8bim" \
  -units PixelsPerInch -density 300 "miff:${TMPDIR_8BIM}/res.miff" \
  && echo "ok" || echo "not ok"
${CONVERT} "miff:${TMPDIR_8BIM}/res.miff" 8BIM:- | od -An -v -tx1 | \
  tr -d ' \n' | grep '03ed000000000010012c000000010001012c000000010001' \
  > /dev/null && echo "ok" || echo "not ok"

rm -rf "${TMPDIR_8BIM}"
:
