#  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
#  See the License for the specific language governing permissions and
#  limitations under the License.
#
#  Regression test for the TIFF IPTC profile round trip: TIFFTAG_RICHTIFFIPTC
#  pads the IPTC data to a multiple of 4 bytes.  The padding must not end up
#  in the iptc profile, nor in the 8BIM IPTC-NAA resource (0x0404), where it
#  would no longer match the IPTC digest resource (0x0425).
#
. ./common.shi
. ${srcdir}/tests/common.shi
echo "1..6"

TMPDIR_TIFF="cli-tiff-iptc_out.d"
rm -rf "${TMPDIR_TIFF}"
mkdir "${TMPDIR_TIFF}" || exit 1

if ! ${CONVERT} -list format 2>/dev/null | grep -q ' TIFF\*\? *rw'; then
  for i in 1 2 3 4 5 6; do echo "ok # SKIP TIFF support not available"; done
  rm -rf "${TMPDIR_TIFF}"
  exit 0
fi

# Each case: an IPTC block, and an 8BIM profile holding that block as 0x0404
# followed by its MD5 as 0x0425.  Case a is 21 bytes (needs 3 pad bytes),
# case b is 8 bytes (already a multiple of 4).  Octal escapes for POSIX printf.
printf '\034\002\005\000\004test\034\002x\000\007caption' \
  > "${TMPDIR_TIFF}/a.iptc"
{
  printf '8BIM\004\004\000\000\000\000\000\025'
  cat "${TMPDIR_TIFF}/a.iptc"
  printf '\000'
  printf '8BIM\004\045\000\000\000\000\000\020U\205\002H\177\353y\301\044\204g\3233\332\236\356'
} > "${TMPDIR_TIFF}/a.8bim"
printf '\034\002\005\000\003abc' > "${TMPDIR_TIFF}/b.iptc"
{
  printf '8BIM\004\004\000\000\000\000\000\010'
  cat "${TMPDIR_TIFF}/b.iptc"
  printf '8BIM\004\045\000\000\000\000\000\020x\076\025\342v\074\134i\301\077\0542\054\240\320\214'
} > "${TMPDIR_TIFF}/b.8bim"

for c in a b; do
  # Test: write a TIFF with the 8BIM profile (IPTC is written alongside it).
  ${CONVERT} -size 16x16 xc:white -profile "8BIM:${TMPDIR_TIFF}/$c.8bim" \
    "${TMPDIR_TIFF}/$c.tif" && echo "ok" || echo "not ok"
  # Test: the iptc profile read back has no padding.
  ${CONVERT} "${TMPDIR_TIFF}/$c.tif" "IPTC:${TMPDIR_TIFF}/$c.out.iptc" && \
    cmp -s "${TMPDIR_TIFF}/$c.iptc" "${TMPDIR_TIFF}/$c.out.iptc" \
    && echo "ok" || echo "not ok"
  # Test: the 8bim profile read back is unchanged, so 0x0404 matches 0x0425.
  ${CONVERT} "${TMPDIR_TIFF}/$c.tif" "8BIM:${TMPDIR_TIFF}/$c.out.8bim" && \
    cmp -s "${TMPDIR_TIFF}/$c.8bim" "${TMPDIR_TIFF}/$c.out.8bim" \
    && echo "ok" || echo "not ok"
done

rm -rf "${TMPDIR_TIFF}"
:
